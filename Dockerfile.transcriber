FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements.transcriber.txt .
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r requirements.transcriber.txt
COPY apps/transcriber_bot ./apps/transcriber_bot

RUN useradd --create-home --uid 10001 appuser
USER appuser

CMD ["python", "-m", "apps.transcriber_bot.main"]
